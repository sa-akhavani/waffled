==================
BOTH Entity and Namespaces
==================

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE BOOK [
<!ENTITY writer "bahruz">
<!ENTITY author SYSTEM "https://waf.akhavani.net">
]>

<BOOK>
<seclab:schema xmlns:seclab="http://localhost"> 
<seclab:table>
  <seclab:item attr="drama">&gt;  <!--this is a comment -->&writer; author</seclab:item>
</seclab:table>
</seclab:schema>
</BOOK>

==================
Only External Entity (without namespaces)
==================

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE BOOK [
<!ENTITY writer "<![CDATA[<h1>title</h1>]]>">
<!ENTITY union "0 union select 'password is: ' || password from user limi 1 -- -">
<!ENTITY author SYSTEM "https://waf.akhavani.net">
]>

<BOOK>
  <item>&writer;</item>
</BOOK>


